NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key_here

# Zoom Meeting SDK Credentials
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# ==========================================================================
# Sistema de E-mails (SMTP)
# --------------------------------------------------------------------------
# Se estas variáveis NÃO forem definidas, o sistema opera em "modo simulado":
# os e-mails são registrados no histórico do painel, mas não são enviados.
# Assim a plataforma nunca quebra por falta de configuração de e-mail.
#
# Exemplos de host: smtp.gmail.com | smtp.sendgrid.net | smtp-relay.brevo.com
# Porta 587 = STARTTLS (recomendado) | Porta 465 = SSL (defina SMTP_SECURE=true)
# ==========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remetente exibido nos e-mails
EMAIL_FROM=contato@cursodeecocardiografia.com
EMAIL_FROM_NAME=ECO RJ

# URL pública da plataforma (usada para montar os links dos e-mails)
APP_URL=https://www.cursodeecocardiografia.com

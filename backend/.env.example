NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key_here

# Zoom Meeting SDK Credentials
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# Mercado Pago (Sistema de Pagamentos)
MP_ACCESS_TOKEN=your_mercado_pago_access_token   # APP_USR-... (produção) ou TEST-... (sandbox)
MP_PUBLIC_KEY=your_mercado_pago_public_key
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# URL base pública da aplicação (usada em back_urls, webhook e links de ativação)
APP_BASE_URL=https://www.ecorj.com

# Segredo da rotina agendada de reconciliação de pagamentos (cron-job.org).
# Protege POST/GET /api/payments/cron/reconcile, que reconsulta no Mercado Pago
# os pedidos pendentes e libera os que já foram pagos (rede de segurança para
# quando o webhook não chega). SEM esta variável o endpoint fica DESATIVADO.
# Gere um valor longo e aleatório, ex.: openssl rand -hex 32
CRON_SECRET=

# SMTP (envio de e-mail de comprovante e serial key)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=ECO RJ <contato@cursodeecocardiografia.com>

# Vercel Blob (Loja de Materiais) — APLICADO.
# Habilita upload de arquivos grandes (> 4.5 MB) via Client Upload e o download
# de materiais por URL ASSINADA temporária (arquivos ficam privados no Blob).
# Em PRODUÇÃO: conecte o Blob Store ao projeto na Vercel (Project → Storage →
# Blob → Connect Project) e o token é injetado automaticamente — não precisa
# colar aqui. Para rodar LOCAL: copie o valor de Storage → Blob → .env.local
# (ou rode `vercel env pull`).
BLOB_READ_WRITE_TOKEN=

NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key_here

# Zoom Meeting SDK Credentials
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# Mercado Pago (Sistema de Pagamentos)
MP_ACCESS_TOKEN=your_mercado_pago_access_token   # APP_USR-... (produção) ou TEST-... (sandbox)
MP_PUBLIC_KEY=your_mercado_pago_public_key
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# URL base pública da aplicação (usada em back_urls, webhook e links de ativação)
APP_BASE_URL=https://www.cursodeecocardiografia.com

# SMTP (envio de e-mail de comprovante e serial key)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=ECO RJ <contato@cursodeecocardiografia.com>

# Vercel Blob (Loja de Materiais) — AINDA NÃO APLICADO.
# Deixe em branco por enquanto. Quando o Vercel Blob for aplicado, defina o token
# (Project → Storage → Blob) e implemente uploadFile/getSignedUrl em
# services/blobStorageService.ts. Enquanto isso, cadastre materiais via URL direta.
BLOB_READ_WRITE_TOKEN=
